<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Inventor.So.AddIn</AssemblyName>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);INVENTOR2027</DefineConstants>
    <InventorInteropDir Condition="'$(InventorInteropDir)' == ''">C:\Program Files\Common Files\Autodesk Shared\Extensions 2027\Framework\Interop</InventorInteropDir>
  </PropertyGroup>
  <Target Name="ValidateInventorReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(InventorInteropDir)\Autodesk.Inventor.Interop.dll')" Text="Real Inventor 2027 interop is required. Set InventorInteropDir to its directory." />
  </Target>
  <ItemGroup>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropDir)\Autodesk.Inventor.Interop.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <None Update="Inventor.So.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
