    <Reference Include="Inventor.So.AddIn"><HintPath>../../src/plugin-so27/bin/M5/net48/Inventor.So.AddIn.dll</HintPath></Reference>
    <Reference Include="Autodesk.Inventor.Interop"><HintPath>C:/Program Files/Common Files/Autodesk Shared/Extensions 2027/Framework/Interop/Autodesk.Inventor.Interop.dll</HintPath><EmbedInteropTypes>false</EmbedInteropTypes></Reference>
