<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <Import Project="../../Inventor2027.Interop.props" />
  <ItemGroup>
    <Reference Include="Inventor.So.AddIn"><HintPath>../../src/plugin-so27/bin/Debug/net10.0-windows/Inventor.So.AddIn.dll</HintPath></Reference>
    <Reference Include="Autodesk.Inventor.Interop">
      <HintPath>$(InventorInteropDir)/Autodesk.Inventor.Interop.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="stdole">
      <HintPath>$(InventorInteropDir)/stdole.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
